# Шаблон настроек. Скопируйте файл в `<repo-root>/config/.env` (репозиторий с
# данными) или в `%LOCALAPPDATA%\ADL-Smart-Search\config\.env` — приложение читает
# `.env` при старте. Старый вариант «рядом с exe» тоже поддерживается.
#
# Правила:
# - кодировка UTF-8, одна пара KEY=VALUE на строку;
# - `#` в начале строки — комментарий; значения с пробелами или `#` берите в кавычки
#   (пути Windows можно писать в двойных кавычках);
# - уже заданные в системе переменные окружения важнее значений из `.env`;
# - базовые настройки (`config/settings.json`, `config/llm.json`,
#   `config/prompts.json`) и пользовательские overrides важнее `.env`; секреты
#   (LLM_API_KEY, GIGACHAT_CREDENTIALS, OPENAI_API_KEY) в llm.json не сохраняются;
# - после изменения файла перезапустите приложение;
# - путь к другому файлу можно задать через ADL_ENV_FILE.
#
# Файл `.env` не коммитится (см. .gitignore).

# Режим путей: auto (по умолчанию), exe или dev.
# dev — проект: <project>/data, <project>/config, <project>/.adl-local
# exe — внешний репозиторий и %LOCALAPPDATA%\ADL-Smart-Search
# ADL_APP_MODE=exe
# ADL_REPO_ROOT=C:\emiastemplates
# ADL_DATA_ROOT=C:\emiastemplates\Soft\ADL Smart Search
# ADL_LOCAL_DIR=%LOCALAPPDATA%\ADL-Smart-Search
# ADL_CONFIG_DIR=C:\emiastemplates\Soft\ADL Smart Search\config
# ADL_USER_CONFIG_DIR=%LOCALAPPDATA%\ADL-Smart-Search\config

# Обновления приложения (exe-режим)
# ADL_UPDATE_CHANNEL=stable          # stable | beta
# ADL_UPDATE_FEED=                   # явный URL манифеста
# ADL_UPDATE_CHECK=1                 # 0 = не проверять

# Автозавершение exe, если браузерная вкладка закрыта (минуты; 0 = отключить)
# ADL_IDLE_EXIT_MINUTES=15

# ADL source and index (пути нужны только при индексации)
# ADL_DIR=C:\path\to\Archetypes
# ADL_INDEX_DIR=.\data
# ADL_LANG=ru
# ADL_AUTO_STRICTNESS=0.6

# Ранжирование и отбор результатов
# ADL_KEYWORD_BONUS=0.5        # вес буквального совпадения (BM25-подобная компонента)
# ADL_MISUSE_PENALTY=0.5       # понижение за совпадение в блоке «НЕДОПУСТИМОЕ ИСПОЛЬЗОВАНИЕ»
# ADL_WEAK_MATCH_PENALTY=0.25  # понижение, если слово нашлось только в имени файла/«якоре»
# ADL_MAX_RESULTS=10          # максимум результатов в выдаче
# ADL_CONTEXT_TOKENS_ARCHETYPES=10000  # бюджет ADL-контекста для вкладки «Архетипы»
# ADL_CONTEXT_TOKENS_FIELDS=10000      # бюджет ADL-контекста для вкладки «Поля»
# ADL_SIM_FLOOR=0.30           # порог схожести для документов с буквальным совпадением
# ADL_SIM_FLOOR_PURE=0.55      # порог схожести для «чисто смысловых» документов (без совпадений)
# ADL_SIM_FLOOR_PURE_CROSS=0.30 # то же для документов на другом языке (запрос без перевода)
# ADL_SIM_LOW_CONFIDENCE=0.45   # ниже порога результат помечается «может быть нерелевантным»

# Вторая база архетипов (например, зеркало CKM). Её индекс — в <ADL_INDEX_DIR>\ckm:
# ADL_CKM_DIR=C:\CKM-mirror\local\archetypes

# Каталог корпоративных моделей (JSON-файл, локальный). По умолчанию читается
# <repo-root>/config/corp_catalog.json.
# ADL_CORP_CATALOG=.\config\corp_catalog.json
# Провайдеры для выпадающего списка (через запятую). Пусто = собрать из каталога.
# ADL_CORP_PROVIDERS=aiedu-v2,mosgpt
# Base url по умолчанию для UI (corp async) в dev-панели.
# ADL_API_BASE_URL_DEFAULT=https://school-test.mos.ru/api/ai/models/v1/message/async/v1

# Embeddings
# ADL_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Необязательный явный путь к файлу промптов. По умолчанию — <config>/prompts.json.
# ADL_PROMPTS_FILE=C:\emiastemplates\Soft\ADL Smart Search\config\prompts.json

# ── LLM ────────────────────────────────────────────────────────────────────
# В .env храним ТОЛЬКО секреты. Остальные настройки LLM (провайдер, модели,
# base url, scope, сертификат, temperature, лимиты, контекст) задаются в
# config/llm.json (админ) и пользовательских overrides — дублирования нет.
# Секреты в llm.json не попадают.
LLM_API_KEY=
GIGACHAT_CREDENTIALS=
# OPENAI_API_KEY=