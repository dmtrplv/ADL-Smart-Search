		["ru"] = <
			items = <
				["at0000"] = <
					text = <"Расчет параметров развития">
					description = <"Расчеты, связанные с развитием ребенка, обычно основанные на его возрасте.">
				>
				["at0001"] = <
					text = <"Серия событий">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Любое событие">
					description = <"Стандартное, неопределенное событие в момент времени или интервала, которое может быть явно определено в шаблоне или во время выполнения.">
				>
				["at0003"] = <
					text = <"Дерево">
					description = <"@ internal @">
				>
				["at0005"] = <
					text = <"Возраст при расчете">
					description = <"Возраст на момент измерения, возможно, скорректированный с учетом преждевременных родов. Может быть выражен в виде условного возраста или в десятичной системе исчисления.">
				>
				["at0010"] = <
					text = <"Перцентиль">
					description = <"Процентиль, рассчитанный с использованием стандартного нормального распределения для данного скорректированного возраста.">
				>
				["at0011"] = <
					text = <"Z-балл (SDS)">
					description = <"Z-балл по результатам показателей для данного возраста.  Z-балл показывает, на сколько баллов данные показатели выше или ниже среднего значения.">
				>
				["at0014"] = <
					text = <"Расчет роста">
					description = <"Описание расчета роста.">
				>
				["at0018"] = <
					text = <"Метод">
					description = <"Метод или алгоритм, с помощью которого были произведены расчеты.">
				>
				["at0019"] = <
					text = <"Комментарий">
					description = <"Комментарий к показателям расчета развития ребенка.">
				>
				["at0020"] = <
					text = <"SDS роста">
					description = <"Расчеты роста/длины для определенного возраста с поправкой на преждевременные роды.">
				>
				["at0021"] = <
					text = <"SDS роста сидя">
					description = <"Расчеты для роста сидя для определенного возраста с поправкой на преждевременные роды.">
				>
				["at0022"] = <
					text = <"SDS длина ног">
					description = <"Расчеты длины ног для определенного возраста с поправкой на преждевременные роды.">
				>
				["at0023"] = <
					text = <"SDS массы тела">
					description = <"Расчеты веса для определенного возраста с поправкой на преждевременные роды.">
				>
				["at0024"] = <
					text = <"SDS окружность головы">
					description = <"Расчеты окружности головы для определенного возраста с поправкой на преждевременные роды.">
				>
				["at0025"] = <
					text = <"Вес/рост">
					description = <"Расчеты веса для определенного возраста.">
				>
				["at0026"] = <
					text = <"Систолическое артериальное давление/возраст и рост">
					description = <"Расчеты систолического артериального давления для определенного возраста с поправкой на преждевременные роды.">
				>
				["at0027"] = <
					text = <"Диастолическое артериальное давление/вес и рост">
					description = <"Расчеты диастолического артериального давления для определенного возраста с поправкой на преждевременные роды.">
				>
				["at0028"] = <
					text = <"Общий комментарий">
					description = <"Комментарий к результатам показателей развития детей, не отраженным в других полях.">
				>
				["at0029"] = <
					text = <"SDS ИМТ">
					description = <"Расчеты индекса массы тела для определенного возраста с поправкой на преждевременные роды.">
				>
				["at0030"] = <
					text = <"С учетом срока беременности">
					description = <"Отметить как \"Истина\", если расчетный возраст был скорректирован с учетом досрочного срока беременности.">
				>
				["at0031"] = <
					text = <"ITEM_TREE">
					description = <"">
				>
			>
		>
	>
