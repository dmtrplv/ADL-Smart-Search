				["at0000"] = <
					text = <"Госпитализация">
					description = <"Архетип для заполнения данных, касающихся госпитализации пациента в стационар. Содержит поля для указания типа госпитализации, номера наряда скорой помощи, стационара и проч.">
				>
				["at0001"] = <
					text = <"Event Series">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Любое событие">
					description = <"Событие по умолчанию, неопределенная точка во времени или интервале, которое может быть явно определено в шаблоне или во время выполнения.">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Тип госпитализации">
					description = <"Для указания планово или экстренно госпитализирован пациент.">
				>
				["at0005"] = <
					text = <"в плановом порядке">
					description = <"Пациент госпитализирован в плановом порядке.">
				>
				["at0006"] = <
					text = <"по экстренным показаниям">
					description = <"Пациент госпитализирован по экстренным показаниям.">
				>
				["at0007"] = <
					text = <"Подробности">
					description = <"Дополнительные структурированные сведения, касающиеся госпитализации пациента.">
				>
				["at0008"] = <
					text = <"Стационар">
					description = <"Информация о месте госпитализации пациента. Рекомендуется использовать внешний справочник.">
				>
				["at0009"] = <
					text = <"Номер наряда скорой помощи">
					description = <"Для указания номера наряда скорой помощи, которая доставила пациента в стационар.">
				>
				["at0010"] = <
					text = <"Обоснование направления">
					description = <"Для указания обоснования направления пациента в стационар.">
				>
				["at0011"] = <
					text = <"Дата поступления в стационар">
					description = <"Для указания даты поступления пациента в стационар.">
				>
				["at0012"] = <
					text = <"Дата выписки из стационара">
					description = <"Для указания даты выписки пациента из стационара.">
				>
				["at0013"] = <
					text = <"Результат госпитализации">
					description = <"Для указания результата/исхода госпитализации пациента.">
				>
				["at0014"] = <
					text = <"выздоровление">
					description = <"Пациент выздоровел.">
				>
				["at0015"] = <
					text = <"улучшение">
					description = <"Пациент выписан с улучшением.">
				>
				["at0016"] = <
					text = <"без перемен">
					description = <"Пациент выписан без изменений в состоянии.">
