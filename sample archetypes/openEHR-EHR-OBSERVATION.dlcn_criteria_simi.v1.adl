ontology
	term_definitions = <
		["ru"] = <
			items = <
				["at0000"] = <
					text = <"Критерии определения гетерозиготной семейной ГХС (DLSN)">
					description = <"Критерии DLCN (Dutch Lipid Clinic Network) используются для диагностики гетерозиготной семейной гиперхолестеринемии (СГХС) у взрослых, т.е у лиц, достигших возраста 18 лет и старше">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Любое событие">
					description = <"@ internal @">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0013"] = <
					text = <"Семейный анамнез">
					description = <"">
				>
				["at0014"] = <
					text = <"Индивидуальный анамнез">
					description = <"">
				>
				["at0015"] = <
					text = <"Физикальное обследование">
					description = <"">
				>
				["at0016"] = <
					text = <"Уровень ЛНП">
					description = <"">
				>
				["at0017"] = <
					text = <"Генетическое обследование">
					description = <"">
				>
				["at0018"] = <
					text = <"Оценка критериев">
					description = <"">
				>
				["at0019"] = <
					text = <"родственник первой степени родства с ранним (у мужчин < 55 лет; у женщин < 60 лет) ССЗ атеросклеротического генеза (ИБС, атеротромботический ишемический инсульт, ТИА, периферический атеросклероз с атеросклеротическими бляшками, стенозирующими просвет сосуда  ≥ 50%)">
					description = <"">
				>
				["at0020"] = <
					text = <"родственник 1-й степени родства с ксантомами сухожилий и/или липоидной дугой роговицы">
					description = <"">
				>
				["at0021"] = <
					text = <"у пациента раннее развитие (у мужчин < 55 лет; у женщин < 60 лет): атеротромботического ишемического инсульта, ТИА или периферический атеросклероз с атеросклеротическими бляшками, стенозирующими просвет сосуда ≥ 50%">
					description = <"">
				>
				["at0022"] = <
					text = <"у пациента ранняя ИБС (у мужчин < 55 лет; у женщин < 60 лет)">
					description = <"">
				>
				["at0023"] = <
					text = <"сухожильные ксантомы">
					description = <"">
				>
				["at0024"] = <
					text = <"липидная дуга роговицы в возрасте < 45 лет">
					description = <"">
				>
				["at0025"] = <
					text = <"больше 8,5 ммоль/л">
					description = <"">
				>
				["at0026"] = <
					text = <"6,5 - 8,4 ммоль/л">
					description = <"">
				>
				["at0027"] = <
					text = <"5,0 - 6,4 ммоль/л">
					description = <"">
				>
				["at0028"] = <
					text = <"4,0 - 4,9 ммоль/л">
					description = <"">
				>
				["at0029"] = <
					text = <"меньше 4,0 ммоль/л">
					description = <"">
				>
				["at0030"] = <
					text = <"наличие патогенного или вероятно патогенного варианта нуклеотидной последовательности LDLR, APOB или PCSK9">
					description = <"">
				>
				["at0031"] = <
					text = <"больше 8 баллов – достоверный диагноз">
					description = <"">
				>
				["at0032"] = <
					text = <"6-8 баллов – вероятный диагноз">
					description = <"">
				>
				["at0033"] = <
					text = <"3-5 баллов – возможный диагноз">
					description = <"">
				>
				["at0034"] = <
					text = <"меньше 2 баллов – диагноз маловероятен">
					description = <"">
				>
				["at0035"] = <
					text = <"Общее количество баллов">
					description = <"">
				>
				["at0041"] = <
					text = <"Подробности">
					description = <"">
				>
				["at0042"] = <
					text = <"Комментарий">
					description = <"">
				>
			>
		>
	>
