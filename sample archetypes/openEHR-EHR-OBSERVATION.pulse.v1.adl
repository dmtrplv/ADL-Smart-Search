				["at1030"] = <
					text = <"Характер пульса">
					description = <"Описание характера пульса или сердечных сокращений.">
					comment = <"По возможности лучше использовать терминологию. Например: полный, нитевидный, вялый, медленно нарастающий или коллапс. Может быть записано несколько терминов.">
				>
				["at1032"] = <
					text = <"пальпация">
					description = <"Определение пульса физическим прикосновением к пациенту.">
