		["ru"] = <
			items = <
				["at0000"] = <
					text = <"Пульс/ЧСС">
					description = <"Запись информации о частоте и ритме сердечных сокращений.">
				>
				["at0001"] = <
					text = <"structure">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"history">
					description = <"@ internal @">
				>
				["at0003"] = <
					text = <"Любое событие">
					description = <"Событие по умолчанию, неопределенная точка во времени или интервале, которое может быть явно определено в шаблоне или во время выполнения.">
				>
				["at0004"] = <
					text = <"Частота">
					description = <"Частота (пульса/сердечных сокращений), измеряемая в уд/мин.">
					comment = <"Ограничения на название были заданы для того, чтобы упростить переименование этого элемента данных в Pulse Rate или Heart Rate, в зависимости от необходимости.">
				>
				["at0005"] = <
					text = <"Ритм">
					description = <"Регулярный ли пульс или ЧСС?">
					comment = <"Правильность и регулярность ритма - это одно и то же.">
				>
				["at0006"] = <
					text = <"правильный">
					description = <"Ритм правильный.">
				>
				["at0007"] = <
					text = <"регулярно нерегулярный">
					description = <"Нерегулярный паттерн в регулярном паттерне. Например, выпадение ритма раз в n ударов.">
				>
				["at0008"] = <
					text = <"нерегулярно нерегулярный">
					description = <"Паттерн нерегулярный, в хаотичном и непредсказуемом ритме. Например, фибрилляция предсердий.">
				>
				["at0010"] = <
					text = <"List">
					description = <"@ internal @">
				>
				["at0012"] = <
					text = <"List">
					description = <"@ internal @">
				>
				["at0013"] = <
					text = <"Положение">
					description = <"Положение тела пациента во время обследования.">
				>
				["at1000"] = <
					text = <"лежа">
					description = <"Пациент лежал в горизонтальном положении.">
				>
				["at1001"] = <
					text = <"сидя">
					description = <"Пациент сидел (например, на кровати или стуле).">
				>
				["at1002"] = <
					text = <"под наклоном">
					description = <"Пациент полулежал под углом примерно 45 градусов, ноги были подняты до уровня таза.">
				>
				["at1003"] = <
					text = <"стоя/вертикально">
					description = <"Пациент стоял, шел или бежал.">
				>
				["at1005"] = <
					text = <"Наличие пульса или сердцебиения">
					description = <"Наличие пульса или сердцебиения.">
					comment = <"Подразумевается, что пульс присутствует, если частота >0 ударов/мин.">
				>
				["at1013"] = <
					text = <"Устройство">
					description = <"Подробности об устройстве, которое используется для измерения частоты пульса или сердечных сокращений.">
				>
				["at1017"] = <
					text = <"Дополнительно">
					description = <"Детали о физических нагрузках, которые будут выполняться во время обследования.">
				>
				["at1018"] = <
					text = <"Искажающие факторы">
					description = <"Описание любых сопутствующих факторов, которые могут повлиять на интерпретацию результатов обследования.">
					comment = <"Например, наличие кардиостимулятора, уровень тревоги; боль или жар и т.д.">
