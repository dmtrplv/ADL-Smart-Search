				["at1019"] = <
					text = <"Метод">
					description = <"Метод, используемый для измерения пульса или ЧСС.">
					comment = <"Например, аускультация или электрокардиограф.">
				>
				["at1022"] = <
					text = <"Клиническое описание">
					description = <"Дополнительная информация о пульсе или ЧСС.">
				>
				["at1023"] = <
					text = <"Клиническая интерпретация результатов">
					description = <"Одно слово, фраза или краткое описание, отражающее клинический смысл и значение результатов исследования пульса или сердечных сокращений, включая ритм.">
					comment = <"По возможности лучше использовать терминологию. Например: Брадикардия, экстрасистолия или синусовый ритм. Допускаются множественные утверждения.">
				>
				["at1024"] = <
					text = <"определяется">
